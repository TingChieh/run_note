# Only copy when .env is absent; replace the DATABASE_URL password placeholder.
# Native Homebrew PostgreSQL/PostGIS; provision role/database separately.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://run_note:replace-with-local-password@127.0.0.1:5432/running_note
SITE_ORIGIN=http://localhost:5173
# S2-03: set AUTH_RATE_HASH_KEY through a secure server/process environment.
# Require >=32 random bytes; keep the SAME key across workers/restarts.
# Missing key disables authentication (503) in development/test; production refuses startup.
# Rotating the key resets matching rate buckets. Never expose it to the browser.
# AUTH_TRUSTED_PROXIES is an optional JSON array of exact trusted proxy IPs; default [].
INTERNAL_API_BASE_URL=http://127.0.0.1:8000
# Optional; use a SEPARATE database with a name ending in _test.
TEST_DATABASE_URL=
# Mandatory when TEST_DATABASE_URL is set; explicit comma-separated host:port/database targets.
# The database name must differ from DATABASE_URL, including aliases/other ports.
# Example: 127.0.0.1:5432/running_note_phase_one_test
# URL query overrides (host/dbname/service/options etc.) are not accepted by the test guard.
TEST_DATABASE_ALLOWED_TARGETS=
# AI is optional. Set these ONLY in the server process environment; never PUBLIC_*.
# Base URL includes the provider's API prefix (e.g. /v1), not /chat/completions.
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-model-name
# AI_API_KEY=inject-from-server-secret-store
AI_DAILY_LIMIT=5
AI_TOTAL_TIMEOUT_SECONDS=30
