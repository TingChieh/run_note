# /etc/run-note/backend.env  (owner root:runnote, mode 0640 or 0600)
# systemd EnvironmentFile format: KEY=VALUE, no `export`, no shell expansion.
# Quote JSON values with SINGLE quotes exactly as shown. Never commit a filled-in copy.
# Verify with: ops/envfile.py check /etc/run-note/backend.env --kind backend

APP_ENV=production

# Role/database are created separately (docs/66). URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://runnote:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/runnote

# Exact external origin, https only, no trailing slash or path.
SITE_ORIGIN=https://CHANGE_ME_DOMAIN

# The only administrator / showcase subject. Must be an existing account (see scripts/site-owner.py).
SITE_OWNER_EMAIL=CHANGE_ME_OWNER_EMAIL

# >= 32 bytes, generated on the server:  openssl rand -base64 48
# Keep the SAME value across restarts and workers. Rotating it only resets rate-limit buckets.
AUTH_RATE_HASH_KEY=CHANGE_ME_GENERATE_ON_SERVER

# REQUIRED behind Caddy. Without it every visitor appears as 127.0.0.1 and shares ONE login
# rate-limit bucket (app/modules/auth/rate_limit.py client_ip).
AUTH_TRUSTED_PROXIES='["127.0.0.1"]'

# Optional AI provider; omit all four to leave the feature reported as unavailable.
# AI_BASE_URL=https://provider.example/v1
# AI_MODEL=model-name
# AI_API_KEY=CHANGE_ME_PROVIDER_KEY
# AI_DAILY_LIMIT=5
