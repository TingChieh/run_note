# /etc/run-note/backup.env  (owner root:postgres, mode 0640)
# Consumed by runnote-backup.service (User=postgres) and by deploy.sh / rollback.sh.
PGDATABASE=runnote
# PGHOST/PGPORT are optional; the default is the local Unix socket with peer authentication.

# Off-site copy (restic, client-side encryption). Strongly recommended. Do not edit by hand:
# `ops/offsite.sh setup` asks for the values at hidden prompts, generates the encryption password
# and writes these keys (see docs/66, "异地备份"). Shown here only to document the shape.
# RESTIC_REPOSITORY=s3:https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com/CHANGE_ME_BUCKET/NAME
# RESTIC_PASSWORD_FILE=/etc/run-note/restic.password
# AWS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SECRET_ACCESS_KEY=CHANGE_ME
# AWS_DEFAULT_REGION=auto

# Dead-man's switch: success pings, /start and /fail are appended automatically.
# HEALTHCHECK_URL=https://hc-ping.com/CHANGE_ME_UUID

# Local retention (counts).
# KEEP_NIGHTLY=14
# KEEP_PRE=10
