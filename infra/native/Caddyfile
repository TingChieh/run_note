# Run Note edge. Install as /etc/caddy/Caddyfile and provide the host name WITHOUT editing this
# file:   systemctl edit caddy   ->   [Service]
#                                     Environment=RUNNOTE_DOMAIN=run.example.com
# Only Caddy is reachable from the Internet; every API and Node port binds to loopback.
#
# Layout: (runnote_app) is the whole application site, parameterised by its two upstream ports.
#   - The site named by RUNNOTE_DOMAIN is the legacy single-instance site (API 8000, Node 3000).
#   - /etc/caddy/access.d/*.caddy is imported INSIDE that site only: use it for access limits that
#     belong to that site alone (the staging host keeps its HTTP basic auth there).
#   - Further instances add their own site block in /etc/caddy/sites.d/<instance>.caddy, rendered
#     by ops/instance.py (maintenance page first, application proxy once it is released).
# A glob import that matches nothing is a no-op, so a host without these directories still works.
# Validate before reload:   RUNNOTE_DOMAIN=run.example.com caddy validate --config /etc/caddy/Caddyfile
#
# Access logging is deliberately NOT enabled: request URIs can contain /shared/<token>; the API's
# own log filter redacts them, Caddy's would not.

(security_headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		# Report-Only first: SvelteKit emits inline scripts, and map/font hosts must be confirmed
		# on the real domain (docs/66). Promote to Content-Security-Policy after a clean soak.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; font-src 'self' data: https://tiles.openfreemap.org; connect-src 'self' https://tiles.openfreemap.org; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}

(runnote_app) {
	encode zstd gzip
	import security_headers

	# Upload ceiling slightly above Node's BODY_SIZE_LIMIT (11M); the API enforces its own limits.
	request_body {
		max_size 12MB
	}

	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:{args[0]} {
			# Overwrite, never append: the application trusts this header only from 127.0.0.1.
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
			transport http {
				response_header_timeout 60s
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:{args[1]} {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	# Friendly answer while a service restarts during a deploy.
	handle_errors {
		@upstream_down expression {err.status_code} in [502, 503, 504]
		handle @upstream_down {
			header Retry-After "30"
			header Cache-Control "no-store"
			respond "服务正在重启或维护，请稍后重试。" 503
		}
	}
}

{$RUNNOTE_DOMAIN} {
	import runnote_app 8000 3000
	import /etc/caddy/access.d/*.caddy
}

import /etc/caddy/sites.d/*.caddy
