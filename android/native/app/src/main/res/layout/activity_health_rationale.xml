<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/runnote_window_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/health_rationale_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/health_rationale_title"
            android:textColor="@color/runnote_foreground"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/health_rationale_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.4"
            android:text="@string/health_rationale_body"
            android:textColor="@color/runnote_muted_foreground"
            android:textSize="15sp" />

        <Button
            android:id="@+id/health_rationale_close_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="@string/health_rationale_close" />
    </LinearLayout>
</ScrollView>
