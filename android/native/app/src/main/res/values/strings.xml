    <string name="connection_error_tls_title">安全连接校验失败</string>
    <string name="connection_error_tls_body">无法验证服务端 HTTPS 证书，已停止加载以保护账户与轨迹安全。</string>
    <string name="connection_error_config_title">客户端服务地址无效</string>
    <string name="connection_error_config_body">当前安装包未配置有效的 HTTPS 服务地址，请使用正式构建版本。</string>
    <string name="connection_error_action_retry">重新加载</string>
    <string name="connection_error_action_back">返回上一页</string>

    <string name="health_rationale_title">健康数据权限说明</string>
    <string name="health_rationale_body">RunNote 仅通过 Health Connect 以只读方式读取你主动授权的运动与恢复指标（步数、距离、活动热量、心率、静息心率、睡眠时长），用于在应用内展示摘要参考。\n\n• 绝不向 Health Connect 写入或修改任何数据。\n• 绝不将健康数据、轨迹或账号凭据发送给第三方。\n• 你可以随时在系统 Health Connect 设置中撤销全部或部分权限。</string>
    <string name="health_rationale_close">关闭</string>
