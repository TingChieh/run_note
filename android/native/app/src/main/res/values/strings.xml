    <string name="connection_error_offline_title">网络连接已断开</string>
    <string name="connection_error_offline_body">当前无法访问网络，请检查 Wi-Fi 或移动数据后重试。页面已加载后可在离线模式下查看已缓存的汇总与跑步记录。</string>
    <string name="connection_error_unreachable_title">无法连接到 RunNote 服务</string>
