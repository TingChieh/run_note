{
  "name": "run-note-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.0.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "showcase": "vite --config vite.showcase.config.ts --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start:local": "node scripts/start-node-local.mjs",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "lint:style": "stylelint \"src/**/*.{css,svelte}\" \"tests/fixtures/**/*.{css,svelte}\"",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-node": "6.0.2",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/three": "^0.187.0",
    "postcss-html": "2.0.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "stylelint": "17.16.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "earcut": "^3.2.4",
    "echarts": "6.1.0",
    "maplibre-gl": "6.18.0",
    "three": "^0.187.0"
  }
}
